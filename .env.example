# Copie este arquivo para .env.local e preencha. NUNCA faça commit do .env.local.

# URL pública do site (local: http://localhost:3000)
APP_URL=http://localhost:3000

# Banco Neon (a integração da Vercel preenche esta variável sozinha)
DATABASE_URL=

# OpenRouter (só usada no servidor)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free

# Login (Google) - Fase 5
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=

# Limites diários de tiragens com IA
RATE_LIMIT_GUEST_PER_DAY=3
RATE_LIMIT_USER_PER_DAY=10

# Identificação enviada ao Nominatim (política de uso do OpenStreetMap)
GEOCODER_USER_AGENT=lunastrology/0.1 (projeto pessoal)

# Chance de uma carta de tarot sair invertida (0 a 1)
TAROT_REVERSED_CHANCE=0.3
