# Copie este arquivo para .env.local e preencha. NUNCA faça commit do .env.local.

# URL pública do site (local: http://localhost:3000)
APP_URL=http://localhost:3000

# Banco Neon (a integração da Vercel preenche esta variável sozinha)
DATABASE_URL=

# OpenRouter (só usada no servidor)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
# Raciocínio dos modelos que "pensam": off (padrão, mais rápido), low, medium ou high
OPENROUTER_REASONING=off

# Login (Google) - Fase 5
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=

# Limites diários de interpretações por IA (cada tipo, tarot e mapa, tem o seu contador)
RATE_LIMIT_GUEST_PER_DAY=3
RATE_LIMIT_USER_PER_DAY=10
# Limites das ações baratas (só contra abuso): mapas criados, tiragens e buscas de cidade novas, por dia e por IP
RATE_LIMIT_CHARTS_PER_DAY=40
RATE_LIMIT_DRAWS_PER_DAY=40
RATE_LIMIT_GEOCODE_PER_DAY=80
# Texto aleatório qualquer; é misturado ao IP antes de guardar o hash (opcional)
RATE_LIMIT_SALT=

# Identificação enviada ao Nominatim (política de uso do OpenStreetMap)
GEOCODER_USER_AGENT=lunastrology/0.1 (projeto pessoal)

# Chance de uma carta de tarot sair invertida (0 a 1)
TAROT_REVERSED_CHANCE=0.3
